{
  "name": "system-atelier",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint -c config/lint.json src tests scripts",
    "format": "oxfmt -c config/format.json src tests scripts",
    "db:generate": "drizzle-kit generate --config=config/database.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "test": "tsx --test tests/studio.test.ts tests/shipping.test.ts tests/database.test.ts",
    "typecheck": "tsc --noEmit",
    "test:http": "python3 tests/auth-http.py"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@libsql/client": "^0.18.0",
    "@noble/hashes": "^2.0.1",
    "@viz-js/viz": "^3.30.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "type": "module"
}
